---
import { site } from '../data/site.js';
const year = new Date().getFullYear();
---
<footer class="ft">
  <div class="shell ft-in">
    <div>
      <p class="ft-name">{site.name}</p>
      <p class="ft-role">{site.title}</p>
    </div>
    <ul class="ft-links">
      <li><a class="link" href={`mailto:${site.email}`}>Email</a></li>
      <li><a class="link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a class="link" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
      <li><a class="link" href="https://dev.to/gbadedata" target="_blank" rel="noopener noreferrer">dev.to</a></li>
      <li><a class="link" href="https://medium.com/@gbadedata" target="_blank" rel="noopener noreferrer">Medium</a></li>
      <li><a class="link" href="https://hashnode.com/@gbade-oj" target="_blank" rel="noopener noreferrer">Hashnode</a></li>
    </ul>
    <p class="ft-copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .ft { border-top: var(--rule); padding-block: 2.4rem; background: var(--background) }
  .ft-in { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.4rem }
  .ft-name { font-family: var(--font-heading); font-weight: 600; font-size: 1.02rem }
  .ft-role { font-size: .92rem; color: var(--muted) }
  .ft-links { display: flex; gap: 1.5rem; flex-wrap: wrap }
  .ft-links a { font-size: .94rem }
  .ft-copy { font-size: .92rem; color: var(--muted) }
  @media (max-width: 700px) { .ft-in { flex-direction: column; align-items: flex-start; gap: 1.1rem } }
</style>
