---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

const {
  title = `${site.name} | ${site.title}`,
  description = 'Data and Cloud Engineer building reliable data platforms, cloud infrastructure and reproducible workflows for operational and scientific data, using Python, SQL, AWS, Azure, Terraform, Docker and Kubernetes.',
  ogTitle = `${site.name} · ${site.title}`,
  ogDescription = 'Data engineering, cloud platform engineering, scientific computing and research supported by detailed technical case studies.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  description: site.positioning,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  sameAs: [site.github, site.linkedin].filter(Boolean),
  knowsAbout: [
    'Data Engineering', 'Cloud Engineering', 'Platform Engineering',
    'Bioinformatics', 'Applied Machine Learning', 'Infrastructure as Code',
  ],
};
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#020659" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={canonical} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />

  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>
